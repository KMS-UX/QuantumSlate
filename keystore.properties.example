# Copy to keystore.properties (gitignored) and fill in to produce signed release builds.
# Without this file, `assembleRelease` still succeeds but the APK is unsigned.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore quantumslate.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias quantumslate
#
# Keep the .jks file and this file out of version control. Losing the keystore means you can
# never update an app already published under it.

storeFile=../quantumslate.jks
storePassword=CHANGE_ME
keyAlias=quantumslate
keyPassword=CHANGE_ME
