<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Vintage Newspaper Fonts for Retro Theme -->
    
    <!-- Primary serif font for headlines (similar to old newspaper mastheads) -->
    <font-family name="vintage_sans_serif">
        <font 
            android:fontStyle="normal"
            android:fontWeight="400"
            android:font="@font/old_standard_tt_regular"
            tools:ignore="UnusedAttribute" />
        <font 
            android:fontStyle="italic"
            android:fontWeight="400"
            android:font="@font/old_standard_tt_italic"
            tools:ignore="UnusedAttribute" />
        <font 
            android:fontStyle="normal"
            android:fontWeight="700"
            android:font="@font/old_standard_tt_bold"
            tools:ignore="UnusedAttribute" />
    </font-family>
    
    <!-- Secondary font for body text (similar to newspaper body copy) -->
    <font-family name="newspaper_body">
        <font 
            android:fontStyle="normal"
            android:fontWeight="400"
            android:font="@font/crimson_text_regular"
            tools:ignore="UnusedAttribute" />
        <font 
            android:fontStyle="italic"
            android:fontWeight="400"
            android:font="@font/crimson_text_italic"
            tools:ignore="UnusedAttribute" />
        <font 
            android:fontStyle="normal"
            android:fontWeight="600"
            android:font="@font/crimson_text_semibold"
            tools:ignore="UnusedAttribute" />
    </font-family>
    
    <!-- Decorative display font for special headers -->
    <font-family name="playfair_display">
        <font 
            android:fontStyle="normal"
            android:fontWeight="400"
            android:font="@font/playfair_display_regular"
            tools:ignore="UnusedAttribute" />
        <font 
            android:fontStyle="normal"
            android:fontWeight="700"
            android:font="@font/playfair_display_bold"
            tools:ignore="UnusedAttribute" />
        <font 
            android:fontStyle="italic"
            android:fontWeight="400"
            android:font="@font/playfair_display_italic"
            tools:ignore="UnusedAttribute" />
    </font-family>
</resources>
