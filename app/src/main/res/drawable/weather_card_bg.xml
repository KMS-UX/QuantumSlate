<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Weather Widget Card Background -->
    
    <!-- Soft gradient background -->
    <gradient 
        android:startColor="#E3F2FD"
        android:endColor="#BBDEFB"
        android:angle="135" />
    
    <!-- Blue border matching weather theme -->
    <stroke 
        android:width="2dp" 
        android:color="#1976D2" />
    
    <corners android:radius="8dp" />
    
    <padding 
        android:left="12dp" 
        android:top="12dp" 
        android:right="12dp" 
        android:bottom="12dp" />
</shape>
