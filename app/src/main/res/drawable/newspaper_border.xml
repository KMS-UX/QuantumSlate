<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vintage Newspaper Border with Aged Paper Effect -->
    
    <!-- Background: aged paper color -->
    <solid android:color="#F5E6D3" />
    
    <!-- Border: dark brown ink-like stroke -->
    <stroke 
        android:width="3dp" 
        android:color="#3E2723" />
    
    <!-- Rounded corners for softer vintage look -->
    <corners android:radius="4dp" />
    
    <!-- Subtle inner shadow effect via padding -->
    <padding 
        android:left="8dp" 
        android:top="8dp" 
        android:right="8dp" 
        android:bottom="8dp" />
</shape>
