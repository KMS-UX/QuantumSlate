<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Gradient background for widget -->
    <gradient
        android:startColor="#1E3A5F"
        android:endColor="#2C5F8D"
        android:angle="135" />
    
    <!-- Rounded corners -->
    <corners android:radius="16dp" />
    
    <!-- Subtle border -->
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
    
    <!-- Padding inside the shape -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
